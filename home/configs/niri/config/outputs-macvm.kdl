// Monitor configuration — UTM / VMware Fusion (Apple Silicon VMs)
// VirtIO-GPU typically exposes "Virtual-1"
// Confirm with: niri msg outputs
// https://niri-wm.github.io/niri/Configuration:-Outputs
output Virtual-1 {
    mode "1920x1080@60"
    scale 1
    transform normal
    position x=0 y=0
}

