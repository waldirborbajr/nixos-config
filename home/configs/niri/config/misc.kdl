spawn-at-startup "nm-applet"
// nextcloud: deixe comentado se quiser menos peso em todas;
// descomente só se usar de verdade no dia a dia
// spawn-at-startup "nextcloud" "--background"

spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "cursor-theme" "capitaine-cursors"

environment {
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    XDG_CURRENT_DESKTOP "Niri"
    XDG_SESSION_DESKTOP "Niri"
    XDG_SESSION_TYPE "wayland"
    DESKTOP_SESSION "niri"
    MOZ_ENABLE_WAYLAND "1"
    CLUTTER_BACKEND "wayland"
    SDL_VIDEODRIVER "wayland"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_SCALE_FACTOR "1"
    QT_AUTO_SCREEN_SCALE_FACTOR "1"
    GDK_SCALE "1"
    GDK_BACKEND "wayland"
    GTK_USE_PORTAL "1"
    // sem WLR_NO_HARDWARE_CURSORS — cursor em hardware
}

cursor {
    xcursor-theme "capitaine-cursors"
    hide-when-typing
    hide-after-inactive-ms 10000
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    off
}

hotkey-overlay {
    skip-at-startup
}
