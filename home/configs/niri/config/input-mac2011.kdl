input {
    keyboard {
        xkb {
            model "macbook79"
            layout "us,us"
            variant ",intl"
            options "compose:ralt,grp:alt_shift_toggle"
        }
        numlock
    }
    touchpad {
        tap
        dwt
        drag true
        natural-scroll
        accel-speed 0.2
        accel-profile "adaptive"
        scroll-method "two-finger"
    }
    mouse {
        accel-speed 0.6
        accel-profile "flat"
    }
    trackpoint {
        off
    }
    warp-mouse-to-focus
}
gestures {
    hot-corners {
        off
    }
}
