input {
    keyboard {
        xkb {
            layout "us"
            variant "mac"
            // model "macbook79"   # opcional
        }
        numlock
    }
    touchpad {
        tap
        dwt
        drag true
        natural-scroll
        accel-speed 0.2
        accel-profile "adaptive"
        scroll-method "two-finger"
    }
    mouse {
        accel-speed 0.6
        accel-profile "flat"
    }
    trackpoint {
        off
    }
    warp-mouse-to-focus
}
gestures {
    hot-corners {
        off
    }
}
