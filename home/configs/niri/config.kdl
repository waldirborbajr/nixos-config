// Main niri config. Split into modules under the same directory.
// https://niri-wm.github.io/niri/Configuration:-Introduction
// https://niri-wm.github.io/niri/Configuration:-Include

include "config/input.kdl"
include "config/outputs.kdl"
include "config/layout.kdl"
include "config/startup.kdl"
include "config/window-rules.kdl"
include "config/binds.kdl"
include "config/misc.kdl"
include "config/workspaces.kdl"


// essential apps
spawn-at-startup "helium"
// spotify só existe no pacote do mac2011 (ver hosts/mac2011/default.nix);
// nas VMs (macutm/macvmf) o binário não está instalado, então checa antes.
spawn-sh-at-startup "command -v spotify >/dev/null 2>&1 && spotify"
// spawn-at-startup "nemo"
spawn-at-startup "pavucontrol"

// systray apps
// spawn-at-startup "blueman-applet"
// spawn-sh-at-startup "nm-applet --sm-disable --indicator"

// wallpaper
// spawn-sh-at-startup "waypaper --restore"

// workspace apps
// spawn-sh-at-startup "kitty -d ~/workspace/nix-config --app-id='nitch' --hold 'nitch' &"
// spawn-sh-at-startup "kitty -d ~/workspace/nix-config --app-id='fastfetch' --hold 'fastfetch' &"
// spawn-sh-at-startup "kitty -d ~/workspace/nix-config --app-id='btm-monitor' --hold 'btm' &"

spawn-sh-at-startup "wezterm start --class 'nitch' --cwd ~/nixos-config -- zsh -ic 'nitch; exec zsh' &"
spawn-sh-at-startup "wezterm start --class 'fastfetch' --cwd ~/nixos-config -- zsh -ic 'fastfetch; exec zsh' &"
spawn-sh-at-startup "wezterm start --class 'btm-monitor' --cwd ~/nixos-config -- zsh -ic 'btm; exec zsh' &"
